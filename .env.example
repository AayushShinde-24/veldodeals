# ──────────────────────────────────────────────────────────────
# Veldo — Environment Variables
# Copy to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — Vel AI agent + email writing (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — billing and credits (required for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_FREE_PRICE_ID=
STRIPE_LAUNCH_PRICE_ID=
STRIPE_EXPAND_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_ADDON_EXPAND_PRICE_ID=
STRIPE_ADDON_SCALE_PRICE_ID=
STRIPE_ADDON_ENTERPRISE_PRICE_ID=
STRIPE_ADDON_FIRST_ONE_PRICE_ID=

# Google OAuth — Gmail and Calendar integration (required for email sending)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Apollo — lead finder and enrichment (optional)
APOLLO_API_KEY=...

# Resend — transactional email (optional, fallback for non-Gmail sends)
RESEND_API_KEY=re_...

# Tavily — company research and web search (optional)
TAVILY_API_KEY=tvly-...

# Zerobounce — email verification (optional)
ZEROBOUNCE_API_KEY=...

# App URL (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — error tracking (optional; inert without a DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cron — shared secret protecting /api/cron/* endpoints (required in production)
CRON_SECRET=

# Boot env enforcement — set to 1 in production to hard-fail on missing required vars
VELDO_ENFORCE_ENV=
