# ──────────────────────────────────────────────────────────────
# Veldo — Environment Variables
# Copy to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — Vel AI agent + email writing (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Dodo Payments — billing and credits (required for payments)
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=whsec_...
DODO_ENVIRONMENT=test            # test | live
# DODO_API_BASE=                 # optional override of the API base URL
# Subscription product IDs (one per plan key):
DODO_PRODUCT_SOLO_LAUNCH_ID=
DODO_PRODUCT_SOLO_MOMENTUM_ID=
DODO_PRODUCT_SOLO_VELOCITY_ID=
DODO_PRODUCT_TEAM_CREW_ID=
DODO_PRODUCT_TEAM_ENGINE_ID=
DODO_PRODUCT_TEAM_POWERHOUSE_ID=
DODO_PRODUCT_ENTERPRISE_SCALE_ID=
DODO_PRODUCT_ENTERPRISE_APEX_ID=
# Add-on credit product IDs (one-time), per plan key as needed:
DODO_ADDON_TEAM_ENGINE_ID=
DODO_ADDON_ENTERPRISE_SCALE_ID=

# Google OAuth — Gmail and Calendar integration (required for email sending)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Apollo — lead finder and enrichment (optional)
APOLLO_API_KEY=...

# Resend — transactional email (optional, fallback for non-Gmail sends)
RESEND_API_KEY=re_...

# Tavily — company research and web search (optional)
TAVILY_API_KEY=tvly-...

# Zerobounce — email verification (optional)
ZEROBOUNCE_API_KEY=...

# App URL (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — error tracking (optional; inert without a DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cron — shared secret protecting /api/cron/* endpoints (required in production)
CRON_SECRET=

# Boot env enforcement — set to 1 in production to hard-fail on missing required vars
VELDO_ENFORCE_ENV=
