# ──────────────────────────────────────────────────────────────
# Veldo — Environment Variables
# Copy to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vel agent brain (required for the agentic chat) + email writing.
# Vel runs on OpenAI gpt-5.4 with tool-calling, DIRECT via api.openai.com (decided
# 2026-07: no OpenRouter/gateway in between). Use a real OpenAI key (sk-…).
# OPENAI_BASE_URL stays unset unless you deliberately route through Azure/a proxy.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4
ANTHROPIC_API_KEY=sk-ant-...
# Model tiers: advanced = high-efficiency tasks, premium = high-stakes email writing only
ANTHROPIC_MODEL_ADVANCED=claude-sonnet-4-6
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-8

# Dodo Payments — billing and credits (required for payments)
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=whsec_...
DODO_ENVIRONMENT=test            # test | live
# DODO_API_BASE=                 # optional override of the API base URL
# Subscription product IDs (one per plan key):
DODO_PRODUCT_SOLO_LAUNCH_ID=
DODO_PRODUCT_SOLO_MOMENTUM_ID=
DODO_PRODUCT_SOLO_VELOCITY_ID=
DODO_PRODUCT_TEAM_CREW_ID=
DODO_PRODUCT_TEAM_ENGINE_ID=
DODO_PRODUCT_TEAM_POWERHOUSE_ID=
DODO_PRODUCT_ENTERPRISE_SCALE_ID=
DODO_PRODUCT_ENTERPRISE_APEX_ID=
# Add-on credit product IDs (one-time), per plan key as needed:
DODO_ADDON_TEAM_ENGINE_ID=
DODO_ADDON_ENTERPRISE_SCALE_ID=

# Google OAuth — Gmail and Calendar integration (required for email sending)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Apollo — lead finder and enrichment (optional)
APOLLO_API_KEY=...

# Resend — transactional email (optional, fallback for non-Gmail sends)
RESEND_API_KEY=re_...

# Tavily — company research and web search (optional)
TAVILY_API_KEY=tvly-...

# Zerobounce — email verification (optional)
ZEROBOUNCE_API_KEY=...

# ── Marketing: ad generation + publishing (Team & Enterprise) ──
# fal.ai — one key for ad creative generation (Seedance 2.0 video + image models)
FAL_KEY=
# FAL_AD_VIDEO_MODEL=fal-ai/bytedance/seedance
# FAL_AD_IMAGE_MODEL=fal-ai/flux/dev
# Ad publishing channels (each requires the platform's Ads API + OAuth):
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN=

# ── Fundraising: investor data (optional; curated fallback used otherwise) ──
INVESTOR_DB_API_KEY=

# ──────────────────────────────────────────────────────────────
# Settings → Integrations connectors (user-connected accounts).
# Each is an OAuth app or API key you create in that platform's developer console;
# the required keys are also shown per-tool under "What you'll need" in the UI.
# ──────────────────────────────────────────────────────────────
# Sales
#   Gmail + Google Calendar → use GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
MS_CLIENT_ID=            # Outlook / Microsoft 365 — Azure AD app (Mail.Send, Mail.Read)
MS_CLIENT_SECRET=
SLACK_CLIENT_ID=         # Slack app (chat:write) — https://api.slack.com/apps
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=       # HubSpot app (CRM scopes) — https://developers.hubspot.com
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=    # Salesforce Connected App
SALESFORCE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=     # Pipedrive app — https://developers.pipedrive.com
PIPEDRIVE_CLIENT_SECRET=
ZOOM_CLIENT_ID=          # Zoom app (meeting:write) — https://marketplace.zoom.us
ZOOM_CLIENT_SECRET=
# Marketing (Meta/Instagram, Google/YouTube Ads, TikTok, LinkedIn use the Ads keys above)
# Fundraising
CARTA_CLIENT_ID=         # Carta API partner — https://developers.carta.com
CARTA_CLIENT_SECRET=
ANGELLIST_ACCESS_TOKEN=  # AngelList / Wellfound API token
CRUNCHBASE_API_KEY=      # Crunchbase Enterprise API
DOCSEND_CLIENT_ID=       # DocSend (Dropbox) API app — https://www.dropbox.com/developers
DOCSEND_CLIENT_SECRET=

# App URL (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — error tracking (optional; inert without a DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cron — shared secret protecting /api/cron/* endpoints (required in production)
CRON_SECRET=

# Boot env enforcement — set to 1 in production to hard-fail on missing required vars
VELDO_ENFORCE_ENV=
